#include <zephyr/dt-bindings/i2c/i2c.h>

/* Olimex STM32-H407 rev B: user LED is on PC13, active-low. */
&green_led_2 {
	gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
};

/*
 * BMP280 on I2C2:
 *   PF header pin 4 = PF1 = SCL
 *   PF header pin 3 = PF0 = SDA
 * Address 0x76 assumes SDO/SA0 is tied to GND.
 */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/*
	 * Recovery taps for a bus that has latched (a device holding SDA low).
	 * With CONFIG_I2C_STM32_BUS_RECOVERY the driver bit-bangs nine clocks and
	 * a STOP over these GPIOs, so a wedged bus does not need a power cycle.
	 * Open-drain: the breakout's pull-ups define the high level.
	 */
	scl-gpios = <&gpiof 1 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;
	sda-gpios = <&gpiof 0 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;

	bmp280: bmp280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};
};

/*
 * Re-arm button.
 *
 * PA0 is the board's user button. Zephyr's own devicetree calls that pin
 * green_led_2, but this project drives the LED on PC13 (see above), so PA0 is
 * free and the two cannot collide.
 *
 * Measured on 2026-11-02: the pin reads LOW at rest with the internal pull-up
 * enabled and the board's own resistor winning, so the button connects the pin
 * to 3V3 and the sense is ACTIVE_HIGH with a pull-down. Reading it as active-low
 * reported a phantom press on every boot.
 *
 * Pressing it starts a new simulated flight without a reboot: detector history
 * and latch cleared, deployment request cleared, baseline recalibrated.
 */
/ {
	rearm_keys {
		compatible = "gpio-keys";

		rearm_button: button {
			label = "Re-arm";
			gpios = <&gpioa 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};
	};
};
